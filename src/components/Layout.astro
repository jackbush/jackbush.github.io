---
import "../styles/global.css";
import {
    defaultColours,
    inkGreys,
    textOpacity,
    type Mode,
} from "../data/theme";

interface Props {
    title?: string;
    theme?: Mode;
}

const { title = "Jack Bush", theme = "projects" } = Astro.props;

// The default theme's colours as CSS variables (the page script swaps them for another theme)
// and the backdrop's ink greys (see inkGreys), all from src/data/theme.ts.
const vars: Record<string, string> = { ...defaultColours.vars };
for (const [kind, opacity] of Object.entries(textOpacity)) {
    for (const [layer, grey] of Object.entries(inkGreys(opacity)))
        vars[`--ink-${layer}-${kind}`] = `color(srgb ${grey} ${grey} ${grey})`;
}
const style = Object.entries(vars)
    .map(([k, v]) => `${k}: ${v}`)
    .join("; ");
---

<html lang="en" data-theme={theme} style={style}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta
            name="description"
            content="I'm a design and product leader who loves making things."
        />
        <link rel="canonical" href="https://jackbush.github.io/" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Jack Bush" />
        <meta property="og:title" content="Jack Bush" />
        <meta
            property="og:description"
            content="I'm a design and product leader who loves making things."
        />
        <meta property="og:url" content="https://jackbush.github.io/" />
        <meta property="og:image" content="https://jackbush.github.io/og.png" />
        <meta property="og:image:alt" content="Jack Bush" />

        <meta name="twitter:card" content="summary_large_image" />

        <meta name="theme-color" content={defaultColours.pages[theme]} />
    </head>
    <body>
        <canvas class="backdrop" aria-hidden="true"></canvas>
        <a href="#main-content" class="skip-link">
            Skip to main content
        </a>
        <div class="container" id="main-content">
            <slot />
        </div>
    </body>
</html>

<style>
    .container {
        width: 100%;
        max-width: 740px;
        margin-inline: auto;
        /* viewport-fit=cover lets the backdrop reach under the browser's bars; keep the
           text clear of notches in landscape. */
        padding-inline: max(var(--gutter), env(safe-area-inset-left))
            max(var(--gutter), env(safe-area-inset-right));
    }
</style>
