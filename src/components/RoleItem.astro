---
interface Props {
    organisation: string;
    role: string;
    dates: string;
    description?: string;
    listItems?: string[];
}

const { organisation, role, dates, description, listItems } = Astro.props;
---

<li>
    <h3>{organisation}</h3>
    <p class="role text-strong">{role} <span class="dates"> ({dates})</span></p>
    {description && <p class="description">{description}</p>}
    {
        listItems && (
            <ul class="highlights">
                {listItems.map((item) => (
                    <li class="text-body">{item}</li>
                ))}
            </ul>
        )
    }
</li>

<style>
    h3 {
        margin: 0;
    }

    .role {
        margin: 0.25rem 0 0;
    }

    .dates {
        font-weight: 400;
    }

    .description {
        margin: 0.5rem 0 0;
    }

    .highlights {
        list-style: disc;
        margin: 0.5rem 0 0;
        padding-left: 1.5rem;
    }

    .highlights li {
        margin: 0;
    }
</style>
