---
interface Props {
    organisation: string;
    role: string;
    dates: string;
    description?: string;
}

const { organisation, role, dates, description } = Astro.props;
---

<li>
    <div class="header">
        <h3>{organisation}</h3>
        <span class="dates">{dates}</span>
    </div>
    <p class="role">{role}</p>
    {description && <p class="description">{description}</p>}
</li>

<style>
    .header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .header h3 {
        margin: 0;
    }

    .dates {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        white-space: nowrap;
    }

    .role {
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text-primary);
        margin: 0.25rem 0 0;
    }

    .description {
        font-size: 1rem;
        line-height: 1.6;
        margin: 0.5rem 0 0;
    }
</style>
