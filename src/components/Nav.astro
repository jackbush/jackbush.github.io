---
const pathname = Astro.url.pathname;

const links = [
    { href: "/",         label: "Home",    hue: "#5E82FF" },
    { href: "/process",  label: "Process", hue: "#FFB800" },
    { href: "/work",     label: "Work",    hue: "#FF5CAE" },
    { href: "/about",    label: "About",   hue: "#A67DFF" },
    { href: "/contact",  label: "Contact", hue: "#A67DFF" },
    { href: "/projects", label: "Projects",hue: "#5E82FF" },
];

function isActive(href: string) {
    return href === "/" ? pathname === "/" : pathname.startsWith(href);
}
---

<header id="site-header">
    <div class="header-inner">
        <a href="/" class="home">Jack Bush</a>
        <button class="burger" id="burger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="menu-overlay">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<div
    class="menu-overlay"
    id="menu-overlay"
    role="navigation"
    aria-label="Site navigation"
    aria-hidden="true"
>
    <div class="menu-inner">
        {links.map(({ href, label, hue }) => (
            <a
                href={href}
                class={isActive(href) ? "active" : ""}
                aria-current={isActive(href) ? "page" : undefined}
                style={`--hue: ${hue}`}
            >
                {label}
            </a>
        ))}
    </div>
</div>

<script>
    const burger      = document.getElementById("burger")!;
    const header      = document.getElementById("site-header")!;
    const overlay     = document.getElementById("menu-overlay")!;
    const mainContent = document.getElementById("main-content");

    function openMenu() {
        header.classList.add("is-open");
        overlay.classList.add("is-open");
        burger.classList.add("is-open");
        burger.setAttribute("aria-expanded", "true");
        burger.setAttribute("aria-label", "Close navigation menu");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        // Hide page content from assistive tech and keyboard while menu is open
        mainContent?.setAttribute("inert", "");
        mainContent?.setAttribute("aria-hidden", "true");
        // Move focus to first menu link
        const first = overlay.querySelector<HTMLElement>("a");
        first?.focus();
    }

    function closeMenu() {
        header.classList.remove("is-open");
        overlay.classList.remove("is-open");
        burger.classList.remove("is-open");
        burger.setAttribute("aria-expanded", "false");
        burger.setAttribute("aria-label", "Open navigation menu");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        mainContent?.removeAttribute("inert");
        mainContent?.removeAttribute("aria-hidden");
        // Return focus to burger
        burger.focus();
    }

    burger.addEventListener("click", () =>
        overlay.classList.contains("is-open") ? closeMenu() : openMenu()
    );

    // Close on link click
    overlay.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));

    // Escape to close
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.classList.contains("is-open")) closeMenu();
    });
</script>

<style>
    /* ── Header bar ─────────────────────────────────── */

    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 200;
        background: var(--color-bg);
        transition: background 0.25s ease;
    }

    .header-inner {
        max-width: 740px;
        margin-inline: auto;
        padding-inline: 1.5rem;
        min-height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 2px solid var(--color-border);
        transition: border-color 0.25s ease;
    }

    .home {
        font-weight: 900;
        font-size: 1.05rem;
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--color-text-primary);
        transition: color 0.25s ease;
        /* ensure 44px tap target height via header min-height */
        display: flex;
        align-items: center;
        min-height: 44px;
    }

    /* ── Burger — 44×44px tap target ────────────────── */

    .burger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 10px;
    }

    .burger span {
        display: block;
        width: 100%;
        height: 2px;
        background: var(--color-text-primary);
        transition: transform 0.22s ease, opacity 0.22s ease, background 0.25s ease;
    }

    .burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger.is-open span:nth-child(2) { opacity: 0; }
    .burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* ── Open state — header goes dark ─────────────── */

    header.is-open {
        background: #07051A;
    }

    header.is-open .header-inner {
        border-bottom-color: rgba(255, 255, 255, 0.07);
    }

    header.is-open .home {
        color: rgba(255, 255, 255, 0.9);
    }

    header.is-open .burger span {
        background: rgba(255, 255, 255, 0.9);
    }

    /* ── Full-page overlay ──────────────────────────── */

    .menu-overlay {
        position: fixed;
        inset: 56px 0 0 0;
        background: #07051A;
        z-index: 199;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-6px);
        transition: opacity 0.25s ease, transform 0.25s ease;
        overflow-y: auto;
        /* Override focus ring for dark bg */
        --focus-ring: rgba(255, 255, 255, 0.9);
    }

    .menu-overlay.is-open {
        opacity: 1;
        pointer-events: all;
        transform: translateY(0);
    }

    /* ── Menu links ─────────────────────────────────── */

    .menu-inner {
        max-width: 740px;
        margin-inline: auto;
        padding: 2.5rem 1.5rem 5rem;
        display: flex;
        flex-direction: column;
    }

    .menu-inner a {
        font-size: clamp(3rem, 10vw, 5.5rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.035em;
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-block: 0.6rem;
        transition: color 0.15s ease;
    }

    .menu-inner a:first-child {
        border-top: none;
    }

    .menu-inner a:hover {
        color: var(--hue);
    }

    /* Active = current page; dimmed but still meets 4.5:1 at 50% white */
    .menu-inner a.active {
        color: rgba(255, 255, 255, 0.5);
    }

    .menu-inner a:focus-visible {
        outline-color: var(--focus-ring);
    }
</style>
