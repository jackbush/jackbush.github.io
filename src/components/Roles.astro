---
// Every role, divided by lines: organisation, then the role and its dates set close as one
// unit, then the description, any highlights and any case studies.
import { linkTo } from "../data/links";
import { formatMonth, roles } from "../data/roles";
import NewTab from "./NewTab.astro";
---

<ul class="roles">
    {roles.map((r) => (
        <li class="item">
            <h2>{r.organisation}</h2>
            <p class="role text-strong">{r.role}</p>
            <p class="dates text-meta">
                <time datetime={r.start}>{formatMonth(r.start)}</time> –
                <time datetime={r.end}>{formatMonth(r.end)}</time>
            </p>
            <p class="description">{r.description}</p>
            {r.listItems && (
                <ul class="highlights">
                    {r.listItems.map((item) => (
                        <li class="text-body">{item}</li>
                    ))}
                </ul>
            )}
            {r.caseStudies && (
                <ul class="case-studies">
                    {r.caseStudies.map(({ label, url }) => {
                        const link = linkTo(url);
                        return (
                            <li>
                                <a class="case-study text-body" {...link.attrs}>
                                    <svg class="icon" viewBox="20 12 216 222" aria-hidden="true">
                                        <path d="M216,36H140V24a12,12,0,0,0-24,0V36H40A20,20,0,0,0,20,56V176a20,20,0,0,0,20,20H71l-16.4,20.5a12,12,0,0,0,18.74,15l28.4-35.5h52.46l28.4,35.5a12,12,0,0,0,18.74-15L185,196h31a20,20,0,0,0,20-20V56A20,20,0,0,0,216,36Zm-4,136H44V60H212Z" />
                                    </svg>
                                    <span class="label">
                                        {link.newTab ? (
                                            <NewTab text={label} />
                                        ) : (
                                            label
                                        )}
                                    </span>
                                </a>
                            </li>
                        );
                    })}
                </ul>
            )}
        </li>
    ))}
</ul>

<style>
    .roles {
        padding-top: var(--card-padding);
    }

    .item + .item {
        margin-top: 2.25rem;
        padding-top: 2.25rem;
        border-top: 1px solid var(--color-text-primary);
    }

    .role {
        margin: 0.5rem 0 0;
    }

    .dates {
        margin: 0;
    }

    .description {
        margin: 0.25rem 0 0;
    }

    .highlights {
        margin: 0.25rem 0 0;
    }

    /* Each highlight hangs off a short dash, a quieter mark than a bullet. */
    .highlights li {
        position: relative;
        margin: 0;
        padding-left: 1.5rem;
    }

    .highlights li + li {
        margin-top: 0.25rem;
    }

    .highlights li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.8em;
        width: 0.625rem;
        border-top: 1px solid var(--color-text-secondary);
    }

    .case-studies {
        margin: 0.5rem 0 0;
    }

    /* A plain underlined line of text, a step heavier than the body, led by Phosphor's
       presentation (bold). Hover fades it a little; a tap only for as long as the finger is
       down. */
    .case-study {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--color-text-primary);
    }

    .icon {
        flex: none;
        width: 1rem;
        height: 1rem;
        fill: currentColor;
    }

    .label {
        text-decoration: underline 1px;
        text-underline-offset: 2px;
    }

    /* The new-tab mark only shows while the link is hovered or focused. */
    .label :global(.mark svg) {
        opacity: 0;
    }

    /* Touch screens never get :hover, which would stick after a tap. On them :active, and the
       copies' .hover (pointerleave comes straight after a tap's pointerup), last as long as the
       finger is down. */
    @media (hover: hover) {
        .case-study:hover {
            opacity: 0.8;
        }

        .case-study:hover .label :global(.mark svg) {
            opacity: 1;
        }
    }

    .case-study:focus-visible .label :global(.mark svg),
    .case-study.hover .label :global(.mark svg) {
        opacity: 1;
    }

    .case-study:active,
    .case-study.hover {
        opacity: 0.8;
    }

    @media (prefers-reduced-motion: no-preference) {
        .case-study,
        .label :global(.mark svg) {
            transition: opacity 150ms ease;
        }
    }

    @media (max-width: 30rem) {
        .item + .item {
            margin-top: 1.75rem;
            padding-top: 1.75rem;
        }
    }
</style>
