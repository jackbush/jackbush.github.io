---
// Every role, divided by lines: organisation, then the role and its dates set close as one
// unit, then the description, any highlights and any case studies. A case study without a
// url opens the password dialog (CaseStudyDialog.astro).
import { formatMonth, roles } from "../data/roles";
import Chevron from "./Chevron.astro";

const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

<ul class="roles">
    {roles.map((r) => (
        <li class="item">
            <h2>{r.organisation}</h2>
            <p class="role text-strong">{r.role}</p>
            <p class="dates text-meta">
                <time datetime={r.start}>{formatMonth(r.start)}</time> –
                <time datetime={r.end}>{formatMonth(r.end)}</time>
            </p>
            <p class="description">{r.description}</p>
            {r.listItems && (
                <ul class="highlights">
                    {r.listItems.map((item) => (
                        <li class="text-body">{item}</li>
                    ))}
                </ul>
            )}
            {r.caseStudies && (
                <ul class="case-studies">
                    {r.caseStudies.map(({ label, url }) => {
                        const text = `Story: ${label}`;
                        const Tag = url ? "a" : "button";
                        const attrs = url
                            ? { href: url, ...newTab }
                            : {
                                  type: "button",
                                  "aria-haspopup": "dialog",
                                  "data-case-study": label,
                              };
                        return (
                            <li>
                                <Tag class="case-study text-body" {...attrs}>
                                    <span class="label">{text}</span>
                                    <Chevron />
                                </Tag>
                            </li>
                        );
                    })}
                </ul>
            )}
        </li>
    ))}
</ul>

<style>
    .roles {
        padding-top: var(--card-padding);
    }

    .item + .item {
        margin-top: 2.25rem;
        padding-top: 2.25rem;
        border-top: 1px solid var(--color-text-primary);
    }

    .role {
        margin: 0.5rem 0 0;
    }

    .dates {
        margin: 0;
    }

    .description {
        margin: 0.25rem 0 0;
    }

    .highlights {
        margin: 0.25rem 0 0;
    }

    /* Each highlight hangs off a short dash, a quieter mark than a bullet. */
    .highlights li {
        position: relative;
        margin: 0;
        padding-left: 1.5rem;
    }

    .highlights li + li {
        margin-top: 0.25rem;
    }

    .highlights li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.8em;
        width: 0.625rem;
        border-top: 1px solid var(--color-text-secondary);
    }

    .case-studies {
        margin: 0.5rem 0 0;
    }

    /* A plain line of text, a step heavier than the body, with its chevron just after it. */
    .case-study {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-height: 2.75rem;
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        font-family: inherit;
        font-weight: 600;
        text-align: left;
        text-decoration: none;
        color: var(--color-text-primary);
        cursor: pointer;
    }

    /* The underline is there all along, clear until hovered. It fades in, and goes at once. */
    .label {
        text-decoration: underline 1px transparent;
        text-underline-offset: 2px;
    }

    .case-study:hover .label,
    .case-study.hover .label {
        text-decoration-color: currentColor;
    }

    @media (prefers-reduced-motion: no-preference) {
        .case-study:hover .label,
        .case-study.hover .label {
            transition: text-decoration-color 300ms ease;
        }
    }

    @media (max-width: 30rem) {
        .item + .item {
            margin-top: 1.75rem;
            padding-top: 1.75rem;
        }
    }
</style>
