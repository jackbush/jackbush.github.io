---
interface Props {
    name: string;
    description: string;
    url: string;
    isWIP?: boolean;
}

const { name, description, url, isWIP = false } = Astro.props;
---

<li>
    <a href={url} target="_blank" rel="noopener noreferrer">
        <span class="name">{name}{isWIP && <span class="wip">WIP</span>}</span>
        <span class="description">{description}</span>
    </a>
</li>

<style>
    li {
        list-style: none;
    }

    a {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        text-decoration: none;
        color: var(--color-text-primary);
    }

    .name {
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .wip {
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-tertiary);
    }

    .description {
        color: var(--color-text-secondary);
    }
</style>
