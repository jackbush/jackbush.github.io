---
interface Props {
    name: string;
    description: string;
    url: string;
}

const { name, description, url } = Astro.props;
---

<li>
    <a href={url} target="_blank" rel="noopener noreferrer">
        <h3 class="name">{name}</h3>
        <p class="description">{description}</p>
    </a>
</li>

<style>
    a {
        display: block;
        text-decoration: none;
    }

    .name {
        margin: 0;
    }

    .description {
        margin: 0.25rem 0 0;
    }
</style>
