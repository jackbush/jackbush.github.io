---
// The mark on a link that opens in a new tab: Phosphor's arrow-square-out (bold), and the same
// said for screen readers. With `text`, the icon follows its last word, so a line never breaks
// before it.
interface Props {
    text?: string;
}

const { text } = Astro.props;
const words = text?.split(" ") ?? [];
const last = words.pop();
---

{words.length > 0 && `${words.join(" ")} `}
<span class="mark">
    {last}
    <svg viewBox="28 28 200 200" aria-hidden="true">
        <path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"></path>
    </svg>
    <span class="hidden">(opens in a new tab)</span>
</span>

<style>
    .mark {
        white-space: nowrap;
    }

    svg {
        width: 0.75em;
        height: 0.75em;
        fill: var(--color-text-primary);
    }

    .hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
