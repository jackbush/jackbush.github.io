---
// The mark on a link that opens in a new tab: Phosphor's arrow-square-out, and the same said
// for screen readers. With `text`, the arrow follows its last word, so a line never breaks before it.
interface Props {
    text?: string;
}

const { text } = Astro.props;
const words = text?.split(" ") ?? [];
const last = words.pop();
---

{words.length > 0 && `${words.join(" ")} `}
<span class="mark">
    {last}
    <svg viewBox="32 32 192 192" aria-hidden="true">
        <path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"></path>
    </svg>
    <span class="hidden">(opens in a new tab)</span>
</span>

<style>
    .mark {
        white-space: nowrap;
    }

    svg {
        width: 0.75em;
        height: 0.75em;
        fill: var(--color-text-primary);
    }

    .hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
