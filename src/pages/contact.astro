---
import Layout from "../components/Layout.astro";
---

<Layout title="Contact — Jack Bush">
    <main>
        <h1>Let's find out if it's a fit.</h1>
        <p>The best starting point is a short call — 30 minutes, no pitch from either side. You tell me where things are, I'll tell you honestly whether I think I can help.</p>
        <p>If you'd rather start in writing, the form below works too.</p>

        <a href="[Calendly link]">Book a 30-minute call →</a>

        <form>
            <div class="field">
                <label for="name">Your name</label>
                <input type="text" id="name" name="name" required />
            </div>

            <div class="field">
                <label for="company">Company / project</label>
                <input type="text" id="company" name="company" />
            </div>

            <div class="field">
                <label for="situation">One sentence on where you're at</label>
                <input type="text" id="situation" name="situation" required />
            </div>

            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
            </div>

            <button type="submit">Send →</button>
        </form>
    </main>
</Layout>

<style>
    form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 2rem;
        max-width: 480px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    label {
        font-size: 0.875rem;
        color: var(--color-text-secondary);
    }

    input {
        font-family: inherit;
        font-size: 1rem;
        color: var(--color-text-primary);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 0.6rem 0.75rem;
        outline: none;
        transition: border-color 0.15s ease;
    }

    input:focus {
        border-color: var(--color-link);
    }

    button {
        font-family: inherit;
        font-size: 1rem;
        color: var(--color-bg);
        background: var(--color-text-primary);
        border: none;
        border-radius: 4px;
        padding: 0.65rem 1.25rem;
        cursor: pointer;
        align-self: flex-start;
        transition: opacity 0.15s ease;
    }

    button:hover {
        opacity: 0.8;
    }
</style>
