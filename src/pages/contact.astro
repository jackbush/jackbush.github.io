---
import Layout from "../components/Layout.astro";
---

<Layout title="Contact — Jack Bush" color="purple">
    <main>
        <p class="eyebrow">Contact</p>
        <h1>Let's find out if it's a fit.</h1>
        <p>The best starting point is a short call — 30 minutes, no pitch from either side. You tell me where things are, I'll tell you honestly whether I think I can help.</p>
        <p>If you'd rather start in writing, the form below works too.</p>

        <a href="[Calendly link]">Book a 30-minute call →</a>

        <form>
            <div class="field">
                <label for="name">Your name</label>
                <input type="text" id="name" name="name" required />
            </div>

            <div class="field">
                <label for="company">Company / project</label>
                <input type="text" id="company" name="company" />
            </div>

            <div class="field">
                <label for="situation">One sentence on where you're at</label>
                <input type="text" id="situation" name="situation" required />
            </div>

            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
            </div>

            <button type="submit">Send →</button>
        </form>
    </main>
</Layout>

<style>
    form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        border-top: 3px solid var(--color-border);
        padding-top: 2.5rem;
        margin-top: 2rem;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    label {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
    }

    input {
        font-family: inherit;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--color-text-primary);
        background: var(--color-bg-subtle);
        border: none;
        border-bottom: 2px solid var(--color-border);
        padding: 0.75rem 0;
        transition: border-color 0.15s ease;
    }

    input:focus {
        border-bottom-color: var(--color-text-primary);
        outline: none; /* border-bottom change is the visible focus indicator */
    }

    input:focus-visible {
        outline: 3px solid var(--color-text-secondary);
        outline-offset: 3px;
    }

    button {
        font-family: inherit;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: var(--color-bg);
        background: var(--color-text-primary);
        border: none;
        padding: 0.8rem 1.5rem;
        cursor: pointer;
        align-self: flex-start;
        transition: opacity 0.15s ease;
    }

    button:hover {
        opacity: 0.8;
    }
</style>
