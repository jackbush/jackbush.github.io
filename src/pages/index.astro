---
import Layout from "../components/Layout.astro";
import ProjectItem from "../components/ProjectItem.astro";
import CVItem from "../components/CVItem.astro";
import { projects } from "../data/projects";
import { experience } from "../data/cv";
---

<Layout color="pink">
    <script is:inline>
        // Runs before first paint so ?mode=work links load blue, not pink.
        if (new URLSearchParams(location.search).get("mode") === "work") {
            document.documentElement.dataset.color = "blue";
        }
    </script>
    <main>
        <section class="intro">
            <h1>Jack Bush</h1>
            <p>
                I've been a designer, a developer, a product manager and a VP.
                I'm most useful at the messy early stage, when the product
                exists but isn't quite right, or the team is there but pulling
                in different directions.
            </p>
        </section>

        <div class="toggle" role="tablist" aria-label="Play or work">
            <button
                role="tab"
                id="tab-play"
                data-mode="play"
                aria-selected="true"
                aria-controls="panel-play">Play</button
            >
            <button
                role="tab"
                id="tab-work"
                data-mode="work"
                aria-selected="false"
                aria-controls="panel-work"
                tabindex="-1">Work</button
            >
        </div>

        <section
            id="panel-play"
            data-mode="play"
            role="tabpanel"
            aria-labelledby="tab-play"
        >
            <ul>
                {
                    projects.map((project) => (
                        <ProjectItem
                            name={project.name}
                            description={project.description}
                            url={project.url}
                        />
                    ))
                }
            </ul>
        </section>

        <section
            id="panel-work"
            data-mode="work"
            role="tabpanel"
            aria-labelledby="tab-work"
            hidden
        >
            <ul>
                {
                    experience.map((entry) => (
                        <CVItem
                            organisation={entry.organisation}
                            role={entry.role}
                            dates={entry.dates}
                            description={entry.description}
                        />
                    ))
                }
            </ul>
        </section>
    </main>
</Layout>

<script>
    const tabs = [
        ...document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    ];
    const panels = [
        ...document.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    ];

    function setMode(mode: string, updateUrl: boolean) {
        document.documentElement.dataset.color =
            mode === "work" ? "blue" : "pink";
        tabs.forEach((tab) => {
            const active = tab.dataset.mode === mode;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
            panel.hidden = panel.dataset.mode !== mode;
        });
        if (updateUrl) {
            const url = new URL(location.href);
            if (mode === "work") url.searchParams.set("mode", "work");
            else url.searchParams.delete("mode");
            history.replaceState(null, "", url);
        }
    }

    tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => setMode(tab.dataset.mode!, true));
        tab.addEventListener("keydown", (e) => {
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            const next = tabs[(i + 1) % tabs.length];
            setMode(next.dataset.mode!, true);
            next.focus();
        });
    });

    const initial =
        new URLSearchParams(location.search).get("mode") === "work"
            ? "work"
            : "play";
    setMode(initial, false);
</script>

<style>
    main {
        padding-block: 4rem 6rem;
    }

    .intro {
        margin-bottom: 3rem;
    }

    .toggle {
        display: flex;
        border: 2px solid var(--color-border);
        margin-bottom: 3rem;
    }

    .toggle button {
        flex: 1;
        min-height: 2.75rem;
        padding: 0.6rem 1rem;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 700;
        border: none;
        background: transparent;
        color: var(--color-text-secondary);
        cursor: pointer;
    }

    .toggle button[aria-selected="true"] {
        background: var(--color-text-primary);
        color: var(--color-bg);
    }

    .education-heading {
        margin-top: 3.5rem;
    }
</style>
