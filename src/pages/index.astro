---
import Layout from "../components/Layout.astro";
import ProjectItem from "../components/ProjectItem.astro";
import RoleItem from "../components/RoleItem.astro";
import { projects } from "../data/projects";
import { roles } from "../data/roles";
---

<Layout theme="projects">
    <script is:inline>
        // Runs before first paint so ?mode=roles links load the dark theme.
        if (new URLSearchParams(location.search).get("mode") === "roles") {
            document.documentElement.dataset.theme = "roles";
            document
                .querySelector('meta[name="theme-color"]')
                ?.setAttribute("content", "#12161D");
        }
    </script>
    <main>
        <section class="intro">
            <h1>Jack Bush</h1>
            <p>
                <strong>
                    I'm a design and product leader who loves making things.
                </strong>
                Since 2005 I've built apps, platforms, teams, design systems, AI
                agents, instruments, a brain-machine interface, exhibitions,
                furniture, and a van. To me, technology is about quality,
                beauty, and the shared tradition of tools that benefit us all.
            </p>
        </section>

        <div class="toggle" role="tablist" aria-label="Projects or roles">
            <button
                role="tab"
                id="tab-projects"
                data-mode="projects"
                aria-selected="true"
                aria-controls="panel-projects"
            >
                Projects
            </button>
            <button
                role="tab"
                id="tab-roles"
                data-mode="roles"
                aria-selected="false"
                aria-controls="panel-roles"
                tabindex="-1"
            >
                Roles
            </button>
        </div>

        <section
            id="panel-projects"
            data-mode="projects"
            role="tabpanel"
            aria-labelledby="tab-projects"
        >
            <ul>
                {projects.map((project) => (
                    <ProjectItem
                        name={project.name}
                        description={project.description}
                        url={project.url}
                    />
                ))}
            </ul>
        </section>

        <section
            id="panel-roles"
            data-mode="roles"
            role="tabpanel"
            aria-labelledby="tab-roles"
            hidden
        >
            <ul>
                {roles.map((entry) => (
                    <RoleItem
                        organisation={entry.organisation}
                        role={entry.role}
                        dates={entry.dates}
                        description={entry.description}
                        listItems={entry.listItems}
                    />
                ))}
            </ul>
        </section>
    </main>
</Layout>

<script>
    const tabs = [
        ...document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    ];
    const panels = [
        ...document.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    ];
    const favicon = document.querySelector<HTMLLinkElement>(
        'link[rel="icon"][type="image/svg+xml"]',
    );
    const themeColor = document.querySelector<HTMLMetaElement>(
        'meta[name="theme-color"]',
    );

    const LABELS: Record<string, string> = {
        projects: "Projects",
        roles: "Roles",
    };

    // Browser chrome colour per theme: warm paper / cool ink.
    const THEME_COLORS: Record<string, string> = {
        projects: "#FCFAF6",
        roles: "#12161D",
    };

    // Fill + contrasting ring so the mark reads on any tab-bar colour.
    function setFavicon(fill: string, stroke: string) {
        if (!favicon) return;
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><circle cx="64" cy="64" r="52" fill="${fill}" stroke="${stroke}" stroke-width="8"/></svg>`;
        favicon.href = "data:image/svg+xml," + encodeURIComponent(svg);
    }

    function setMode(mode: string, updateUrl: boolean) {
        document.documentElement.dataset.theme = mode;
        document.title = `Jack Bush | ${LABELS[mode]}`;
        themeColor?.setAttribute("content", THEME_COLORS[mode]);
        if (mode === "roles") setFavicon("#12161D", "#EEF1F6");
        else setFavicon("#FFFFFF", "#12161D");
        tabs.forEach((tab) => {
            const active = tab.dataset.mode === mode;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
            panel.hidden = panel.dataset.mode !== mode;
        });
        if (updateUrl) {
            const url = new URL(location.href);
            url.searchParams.set("mode", mode);
            history.replaceState(null, "", url);
        }
    }

    tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => setMode(tab.dataset.mode!, true));
        tab.addEventListener("keydown", (e) => {
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            const next = tabs[(i + 1) % tabs.length];
            setMode(next.dataset.mode!, true);
            next.focus();
        });
    });

    const initial =
        new URLSearchParams(location.search).get("mode") === "roles"
            ? "roles"
            : "projects";
    setMode(initial, false);
</script>

<style>
    main {
        padding-block: 4rem 6rem;
    }

    .intro {
        margin-bottom: 3rem;
    }

    .toggle {
        display: flex;
        border: 2px solid var(--color-text-primary);
        margin-bottom: 3rem;
    }

    .toggle button {
        flex: 1;
        min-height: 2.75rem;
        padding: 0.6rem 1rem;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
    }

    /* Fixed blocks: Projects is always dark, Roles always light. The page
       context around them optically switches which one reads as active. */
    .toggle button[data-mode="projects"] {
        background: var(--ink);
        color: var(--ink-paper);
    }

    .toggle button[data-mode="roles"] {
        background: var(--paper);
        color: var(--paper-ink);
    }
</style>
